<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle, metaDescription, canonicalUrl }) %>
  </head>
  <body class="min-h-screen bg-navy-800 text-slate-200 antialiased">
    <main class="flex min-h-screen flex-col items-center justify-center px-4 py-20 text-center">
      <img
        src="/images/logo_kali.jpg"
        alt="<%= site.name %> logo"
        width="96"
        height="96"
        class="h-24 w-24 rounded-full border border-gold-500/60 object-cover shadow-gold"
      />
      <p class="mt-8 font-display text-6xl font-bold text-gold-400">404</p>
      <h1 class="mt-3 font-display text-3xl font-bold text-cream">This page is not on the menu</h1>
      <p class="mt-4 max-w-md text-slate-400">
        The page you were looking for has moved or never existed. Let us take you back to the good stuff.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-gold">Back to home</a>
        <a href="tel:<%= site.phoneE164 %>" class="btn-outline">Call <%= site.phone %></a>
      </div>
    </main>
  </body>
</html>
