<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle, metaDescription, canonicalUrl }) %>
  </head>
  <body class="min-h-screen bg-navy-800 text-slate-200 antialiased">
    <main class="flex min-h-screen flex-col items-center justify-center px-4 py-20 text-center">
      <p class="font-display text-6xl font-bold text-gold-400">500</p>
      <h1 class="mt-3 font-display text-3xl font-bold text-cream">Something went wrong on our side</h1>
      <p class="mt-4 max-w-md text-slate-400">
        We are sorry about that. Please try again in a moment, or contact us on WhatsApp or by phone.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-gold">Back to home</a>
        <a href="<%= site.whatsappUrl %>" class="btn-outline" target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>
        <a href="tel:<%= site.phoneE164 %>" class="btn-outline">Call <%= site.phone %></a>
      </div>
    </main>
  </body>
</html>
