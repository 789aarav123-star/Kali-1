<section id="visit" class="bg-navy-900 py-20 sm:py-24" aria-labelledby="visit-heading">
  <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="eyebrow">Find Us</p>
      <h2 id="visit-heading" class="mt-3 font-display text-3xl font-bold text-cream sm:text-4xl">
        On the ring road in Janakpur Dham
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-400">
        We are easy to reach from every corner of Janakpur. Drop in for dinner, pick up a takeaway, or call us
        to arrange a cabin for your family this weekend.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[1.4fr_1fr]">
  <!-- Map -->
  <div class="flex h-[320px] w-full overflow-hidden rounded-2xl border border-white/10 shadow-card sm:h-[420px]">
    <iframe
      src="<%= site.mapEmbedUrl %>"
      title="Google Map showing Kali Hotel and Restaurant, Ring Road, Janakpur Dham"
      class="h-full w-full border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>



      <!-- Contact details -->
      <div class="space-y-4">
        <div class="rounded-2xl border border-white/10 bg-navy-800/70 p-6">
          <h3 class="font-display text-xl font-semibold text-cream">Contact &amp; location</h3>
          <address class="mt-4 space-y-4 text-sm not-italic text-slate-400">
            <p class="flex gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10 2a6 6 0 0 0-6 6c0 4.2 6 10 6 10s6-5.8 6-10a6 6 0 0 0-6-6Zm0 8.25A2.25 2.25 0 1 1 10 5.75a2.25 2.25 0 0 1 0 4.5Z" />
              </svg>
              <span><%= site.address.full %></span>
            </p>
            <p class="flex gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7a2 2 0 0 1 1.73 2.03Z" />
              </svg>
              <a class="footer-link" href="tel:<%= site.phoneE164 %>"><%= site.phone %></a>
            </p>
            <p class="flex gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm1 8V4h-2v7h5v-2h-3Z" />
              </svg>
              <span>
                <% site.hours.forEach((hours, index) => { %>
                  <% if (index) { %><br /><% } %><%= hours.days %>: <%= hours.time %>
                <% }) %>
              </span>
            </p>
            <p class="flex gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5h1.65V4.6A22 22 0 0 0 14.3 4.5c-2.4 0-4 1.45-4 4.12v2.28H7.6V14h2.7v8h3.2Z" />
              </svg>
              <a class="footer-link" href="<%= site.facebook %>" target="_blank" rel="noopener noreferrer">
                Facebook page
              </a>
            </p>
          </address>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="<%= site.mapsUrl %>" class="btn-gold flex-1" target="_blank" rel="noopener noreferrer">
              Get directions
            </a>
            <a href="tel:<%= site.phoneE164 %>" class="btn-outline flex-1">Call us</a>
          </div>
        </div>

        <!-- FAQ -->
        <div class="rounded-2xl border border-white/10 bg-navy-800/70 p-6">
          <h3 class="font-display text-xl font-semibold text-cream">FAQs</h3>
          <div class="mt-4 divide-y divide-white/10">
            <% site.faq.forEach((item) => { %>
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-cream marker:hidden">
                  <%= item.q %>
                  <svg class="h-4 w-4 shrink-0 text-gold-400 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M9 4h2v5h5v2h-5v5H9v-5H4V9h5V4Z" />
                  </svg>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-slate-400"><%= item.a %></p>
              </details>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
