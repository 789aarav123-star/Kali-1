<section id="menu" class="relative bg-navy-800 py-20 sm:py-24" aria-labelledby="menu-heading">
  <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="max-w-2xl">
      <p class="eyebrow">Our Kitchen</p>
      <h2 id="menu-heading" class="mt-3 font-display text-3xl font-bold text-cream sm:text-4xl">
        A multi-cuisine menu under one roof
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-400">
        From biryani and momos to gravies, naan, fried rice and chowmein — browse the dishes our guests
        in Janakpur Dham keep coming back for.
      </p>
    </div>

    <!-- Category tabs -->
    <div class="mt-10">
      <h3 class="sr-only">Filter the menu by category</h3>
      <div
        id="menu-tabs"
        class="flex flex-wrap gap-2 rounded-2xl border border-white/10 bg-navy-900/60 p-2"
        role="tablist"
        aria-label="Menu categories"
      >
        <% site.menuCategories.forEach((category, index) => { %>
          <button
            type="button"
            role="tab"
            id="tab-<%= category.id %>"
            class="tab-button <%= index === 0 ? 'is-active' : '' %>"
            data-filter="<%= category.id %>"
            aria-controls="menu-grid"
            aria-selected="<%= index === 0 ? 'true' : 'false' %>"
            tabindex="<%= index === 0 ? '0' : '-1' %>"
          >
            <%= category.label %>
          </button>
        <% }) %>
      </div>

      <p id="menu-status" class="mt-4 text-sm text-slate-400" role="status" aria-live="polite">
        Showing all <%= site.menu.length %> dishes.
      </p>
    </div>

    <!-- Dish grid -->
    <div
      id="menu-grid"
      class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      role="tabpanel"
      aria-labelledby="tab-all"
    >
      <% site.menu.forEach((dish) => { %>
        <article class="menu-card group" data-category="<%= dish.category %>">
          <div class="relative overflow-hidden rounded-t-2xl">
            <img
              src="<%= dish.image %>"
              alt="<%= dish.alt %>"
              width="960"
              height="720"
              loading="lazy"
              decoding="async"
              class="h-60 w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <% if (dish.badge) { %>
              <span
                class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold shadow-card <%= dish.badge.tone === 'emerald' ? 'bg-emerald-500/95 text-emerald-950' : 'bg-gold-500/95 text-navy-900' %>"
              >
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M10 1.8l2.35 4.76 5.25.77-3.8 3.7.9 5.23L10 13.94l-4.7 2.32.9-5.23-3.8-3.7 5.25-.77L10 1.8Z" />
                </svg>
                <%= dish.badge.label %>
              </span>
            <% } %>
          </div>

          <div class="flex flex-1 flex-col p-6">
            <h3 class="font-display text-xl font-semibold text-cream"><%= dish.name %></h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400"><%= dish.description %></p>
            <% if (dish.badge && dish.badge.note) { %>
              <p class="mt-4 flex items-start gap-2 rounded-lg border border-gold-500/20 bg-gold-500/10 px-3 py-2 text-xs font-medium text-gold-300">
                <svg class="mt-0.5 h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M10 1.8l2.35 4.76 5.25.77-3.8 3.7.9 5.23L10 13.94l-4.7 2.32.9-5.23-3.8-3.7 5.25-.77L10 1.8Z" />
                </svg>
                <span><%= dish.badge.note %></span>
              </p>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>

    <!-- Reviewer recommendations -->
    <div class="mt-12 rounded-2xl border border-white/10 bg-navy-900/60 p-6 sm:p-8">
      <h3 class="font-display text-xl font-semibold text-cream">What our guests recommend</h3>
      <p class="mt-2 text-sm text-slate-400">
        Straight from the Google reviews our local guides left after dining with us.
      </p>
      <ul class="mt-6 flex flex-wrap gap-3">
        <% site.recommendedDishes.forEach((dish) => { %>
          <li class="inline-flex items-center gap-2 rounded-full border border-gold-500/30 bg-navy-800 px-4 py-2 text-sm font-medium text-gold-300">
            <span class="font-semibold text-cream"><%= dish.name %></span>
            <span class="text-xs text-slate-400">&mdash; <%= dish.note %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>
