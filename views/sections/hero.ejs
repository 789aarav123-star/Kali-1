<section id="top" class="relative isolate overflow-hidden bg-navy-900">
  <!-- Background -->
  <div class="hero-bg absolute inset-0 -z-10" role="img" aria-label="The bar counter and LED lighting of the Kali Hotel lounge"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-navy-900/85 via-navy-900/80 to-navy-800" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_right,rgba(212,175,55,0.18),transparent_55%)]" aria-hidden="true"></div>

  <div class="mx-auto flex min-h-[92vh] max-w-container flex-col justify-center px-4 pb-16 pt-32 sm:px-6 sm:pt-36 lg:px-8 lg:pb-24">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-gold-500/40 bg-navy-900/70 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.22em] text-gold-300 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-gold-400" aria-hidden="true"></span>
        Janakpur Dham &middot; Ring Road
      </p>

      <h1 class="mt-6 font-display text-4xl font-bold leading-[1.08] text-cream sm:text-5xl lg:text-6xl">
        Kali Hotel <span class="text-gold-400">&amp;</span> Restaurant
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 sm:text-xl">
        <%= site.description %>
      </p>

      <!-- Rating badge -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#reviews"
          class="inline-flex items-center gap-3 rounded-2xl border border-gold-500/30 bg-navy-900/70 px-4 py-2.5 backdrop-blur transition hover:border-gold-500/70"
          aria-label="Rated <%= site.rating.value %> out of 5 stars on Google from <%= site.rating.count %> reviews"
        >
          <span class="flex items-center gap-0.5" aria-hidden="true">
            <% for (let i = 0; i < 5; i += 1) { %>
              <svg class="h-4 w-4 <%= i < 4 ? 'text-gold-500' : 'text-gold-500/40' %>" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 1.8l2.35 4.76 5.25.77-3.8 3.7.9 5.23L10 13.94l-4.7 2.32.9-5.23-3.8-3.7 5.25-.77L10 1.8Z" />
              </svg>
            <% } %>
          </span>
          <span class="text-sm font-semibold text-cream"><%= site.rating.value.toFixed(1) %> out of 5</span>
          <span class="text-sm text-slate-400">(<%= site.rating.count %> reviews)</span>
        </a>

        <span class="rounded-2xl border border-white/10 bg-navy-900/60 px-4 py-2.5 text-sm text-slate-300 backdrop-blur">
          <%= site.cuisines.slice(0, 4).join(' · ') %>
        </span>
      </div>

      <!-- Calls to action -->
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="<%= site.whatsappUrl %>" class="btn-gold" target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 2a8 8 0 0 0-6.84 12.15L2 18l3.98-1.05A8 8 0 1 0 10 2Zm0 14.5a6.48 6.48 0 0 1-3.3-.9l-.24-.14-2.36.62.63-2.3-.16-.25A6.5 6.5 0 1 1 10 16.5Zm3.57-4.87c-.2-.1-1.16-.58-1.34-.65-.18-.07-.31-.1-.44.1-.13.19-.5.65-.61.78-.11.13-.23.15-.43.05-.2-.1-.84-.31-1.6-.99-.6-.54-1-1.21-1.12-1.41-.12-.2-.01-.31.09-.41.09-.08.2-.23.3-.34.1-.11.13-.2.2-.33.06-.13.03-.25-.02-.35-.05-.1-.44-1.06-.6-1.45-.16-.38-.32-.33-.44-.34h-.37c-.13 0-.34.05-.52.25-.18.2-.68.67-.68 1.63s.7 1.9.8 2.03c.1.13 1.38 2.1 3.35 2.95.47.2.83.33 1.11.42.47.15.9.13 1.24.08.38-.06 1.16-.47 1.33-.93.16-.46.16-.85.11-.93-.04-.08-.18-.13-.38-.23Z" />
          </svg>
          Book on WhatsApp
        </a>
        <a
          href="tel:<%= site.phoneE164 %>"
          class="btn-outline"
          aria-label="Call Kali Hotel and Restaurant on <%= site.phone %>"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7a2 2 0 0 1 1.73 2.03Z" />
          </svg>
          <%= site.phone %>
        </a>
        <a href="#menu" class="btn-ghost">See the menu</a>
      </div>
    </div>
  </div>

  <!-- Feature strip -->
  <div class="border-t border-white/10 bg-navy-900/80 backdrop-blur">
    <div class="mx-auto grid max-w-container gap-px bg-white/10 px-0 sm:grid-cols-2 lg:grid-cols-4">
      <% site.highlights.forEach((item) => { %>
        <div class="bg-navy-900/90 px-6 py-6">
          <h2 class="font-display text-lg font-semibold text-cream"><%= item.title %></h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-400"><%= item.text %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
