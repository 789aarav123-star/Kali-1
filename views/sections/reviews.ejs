<section id="reviews" class="bg-navy-800 py-20 sm:py-24" aria-labelledby="reviews-heading">
  <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-14">
      <!-- Rating summary -->
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">Guest Reviews</p>
        <h2 id="reviews-heading" class="mt-3 font-display text-3xl font-bold text-cream sm:text-4xl">
          Rated <%= site.rating.value.toFixed(1) %> stars by our guests
        </h2>

        <div class="mt-8 rounded-2xl border border-gold-500/30 bg-navy-900/70 p-6 text-center">
          <p class="font-display text-6xl font-bold text-cream"><%= site.rating.value.toFixed(1) %></p>
          <div class="mt-3 flex items-center justify-center gap-1" aria-hidden="true">
            <% for (let i = 0; i < 5; i += 1) { %>
              <svg class="h-6 w-6 <%= i < 4 ? 'text-gold-500' : 'text-gold-500/40' %>" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 1.8l2.35 4.76 5.25.77-3.8 3.7.9 5.23L10 13.94l-4.7 2.32.9-5.23-3.8-3.7 5.25-.77L10 1.8Z" />
              </svg>
            <% } %>
          </div>
          <p class="mt-3 text-sm text-slate-400">
            Based on <strong class="font-semibold text-cream"><%= site.rating.count %></strong> Google reviews
          </p>
          <a
            href="<%= site.mapsUrl %>"
            class="btn-outline mt-6 w-full"
            target="_blank"
            rel="noopener noreferrer"
          >
            See all reviews
          </a>
        </div>
      </div>

      <!-- Review cards -->
      <div class="grid gap-6">
        <% site.reviews.forEach((review) => { %>
          <article class="rounded-2xl border border-white/10 bg-navy-900/60 p-6 sm:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-1" aria-label="<%= review.rating %> out of 5 stars">
                <% for (let i = 0; i < 5; i += 1) { %>
                  <svg class="h-4 w-4 <%= i < review.rating ? 'text-gold-500' : 'text-gold-500/30' %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M10 1.8l2.35 4.76 5.25.77-3.8 3.7.9 5.23L10 13.94l-4.7 2.32.9-5.23-3.8-3.7 5.25-.77L10 1.8Z" />
                  </svg>
                <% } %>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M10 1.8l2.35 4.76 5.25.77-3.8 3.7.9 5.23L10 13.94l-4.7 2.32.9-5.23-3.8-3.7 5.25-.77L10 1.8Z" />
                </svg>
                <%= review.role %>
              </span>
            </div>

            <blockquote class="mt-5">
              <p class="text-base leading-relaxed text-slate-300 sm:text-lg">&ldquo;<%= review.text %>&rdquo;</p>
            </blockquote>

            <footer class="mt-6 flex items-center gap-3 border-t border-white/10 pt-5">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold-gradient font-display text-lg font-bold text-navy-900"
                aria-hidden="true"
              >
                <%= review.author.charAt(0) %>
              </span>
              <div>
                <p class="text-sm font-semibold text-cream"><%= review.author %></p>
                <p class="text-xs text-slate-400"><%= review.role %> &middot; <%= review.reviewCount %> reviews</p>
              </div>
            </footer>
          </article>
        <% }) %>

        <div class="rounded-2xl border border-white/10 bg-navy-900/60 p-6 text-center sm:p-8">
          <h3 class="font-display text-xl font-semibold text-cream">Dined with us recently?</h3>
          <p class="mx-auto mt-2 max-w-md text-sm text-slate-400">
            Your review helps other families in Janakpur Dham find us — and it helps us get better.
          </p>
          <a
            href="<%= site.mapsUrl %>"
            class="btn-gold mt-6"
            target="_blank"
            rel="noopener noreferrer"
          >
            Write a Google review
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
